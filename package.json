{
  "name": "agent-org",
  "version": "0.91.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "An AI agent organisation as a tool: rows, claims, the board, the merge queue and the wake gate, run against the repository it is installed in.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/agent-org.git"
  },
  "bin": {
    "agent-org": "src/bin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@a11ign/toolchain": "^0.1.5",
    "@rstest/core": "^0.12.3",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "rstest run --config scripts/rstest/rstest.config.ts",
    "changeset": "pnpm dlx @changesets/cli@3.0.1",
    "messaging:listen": "node --import tsx src/messaging/listen.mjs",
    "messaging:watch": "node --import tsx src/messaging/watch.mjs",
    "messaging:pair": "node --import tsx src/messaging/providers/telegram/pair.mjs",
    "ruling:record": "node --import tsx src/ruling-record.ts",
    "messaging:measure": "node --import tsx src/messaging/measure.ts",
    "chairman:reply": "node --import tsx src/messaging/reply-cli.mjs",
    "chairman:record": "node --import tsx src/messaging/record.mjs",
    "chairman:correct": "node --import tsx src/messaging/correct.ts",
    "chairman:ask-ceo": "node --import tsx src/messaging/ask-ceo.ts",
    "chairman:watch": "node --import tsx src/messaging/watch-list.mjs",
    "chairman:queue": "node --import tsx src/messaging/session-queue.mjs"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "host",
    "LICENSE",
    "README.md"
  ]
}
