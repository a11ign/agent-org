{
  "name": "agent-org",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "An AI agent organisation as a tool: rows, claims, the board, the merge queue and the wake gate, run against the repository it is installed in.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/agent-org.git"
  },
  "bin": {
    "agent-org": "src/bin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "messaging:listen": "node src/messaging/listen.mjs",
    "messaging:watch": "node src/messaging/watch.mjs",
    "messaging:pair": "node src/messaging/providers/telegram/pair.mjs",
    "ruling:record": "node src/ruling-record.mjs",
    "chairman:reply": "node src/messaging/reply-cli.mjs"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "host",
    "LICENSE",
    "README.md"
  ]
}
