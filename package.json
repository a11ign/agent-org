{
  "name": "agent-org",
  "version": "0.277.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "An AI agent organisation as a tool: rows, claims, the board, the merge queue and the wake gate, run against the repository it is installed in.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/agent-org.git"
  },
  "bin": {
    "agent-org": "src/bin.ts"
  },
  "exports": {
    "./acceptance-commands": "./src/acceptance-commands.ts",
    "./acceptance-file": "./src/acceptance-file.ts",
    "./board-data": "./src/board-data.ts",
    "./board-document": "./src/board-document.ts",
    "./leak-patterns": "./src/lib/leak-patterns.ts",
    "./merge-guard-lookups": "./src/merge-guard/lookups.ts",
    "./newest-check-run": "./src/newest-check-run.ts",
    "./pr-open": "./src/pr-open.ts",
    "./project-config": "./src/project-config.ts",
    "./tree-wide-guard": "./src/lib/tree-wide-guard.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@a11ign/toolchain": "^0.7.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@george2f/eslint-plugin-clean-code": "0.4.1",
    "@rstest/core": "^0.12.3",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --no-error-on-unmatched-pattern src scripts plugins",
    "test": "node scripts/test-entry.ts",
    "changeset": "pnpm dlx @changesets/cli@3.0.1",
    "messaging:listen": "node src/messaging/listen.ts",
    "messaging:chats": "node src/messaging/chats.ts",
    "messaging:watch": "node src/messaging/watch.ts",
    "messaging:pair": "node src/messaging/pair.ts",
    "ruling:record": "node src/ruling-record.ts",
    "messaging:measure": "node src/messaging/measure.ts",
    "chairman:reply": "node src/messaging/reply-cli.ts",
    "chairman:record": "node src/messaging/record.ts",
    "chairman:correct": "node src/messaging/correct.ts",
    "chairman:ask-ceo": "node src/messaging/ask-ceo.ts",
    "chairman:watch": "node src/messaging/watch-list.ts",
    "chairman:queue": "node src/messaging/session-queue.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "plugins",
    "!plugins/**/*.test.ts",
    "host",
    "LICENSE",
    "README.md"
  ]
}
