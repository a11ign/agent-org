{
  "name": "agent-org-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The board UI: Astro with React islands, built to static files. A standalone package of its own, not a workspace member.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "rstest run --config rstest.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@a11ign/toolchain": "0.10.2",
    "@astrojs/check": "^0.9.12",
    "@rstest/core": "^0.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.6",
    "playwright-core": "1.64.1",
    "typescript": "^6.0.3"
  }
}
