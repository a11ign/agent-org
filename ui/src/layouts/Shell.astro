---
import "../styles.css";
import { cacheKey } from "../api/session-cache.ts";

interface Props {
  /** The document title the board gives the page, such as "Atomaut: Tickets". */
  title: string;
}

const { title } = Astro.props;
// Where the tab keeps the connections list (A11-270): with it, the island draws the page from the tab's kept answers as it hydrates.
const keptList = cacheKey(null, "/api/connections");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- A tab that has drawn a page before holds back the island's static HTML, which is its skeleton, until the shell has drawn what the tab kept (`ShellProvider.tsx`, A11-270). -->
    <script is:inline define:vars={{ keptList }}>
      try {
        if (sessionStorage.getItem(keptList) !== null) document.documentElement.dataset.kept = "";
      } catch {
        // Refused storage keeps nothing, so the skeleton is what the page draws first.
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
