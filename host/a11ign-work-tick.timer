[Unit]
Description=a11ign: run the org's work tick
Requires=a11ign-work-tick.service

[Timer]
# TWO MINUTES IS CHOSEN FROM THE RATE LIMIT, NOT BY FEEL. `work-gate` costs two `gh` calls; at this
# interval that is 1,440 calls a day against a 5,000/hour limit, so the tick can run all day and never
# be the thing that runs out. `work-gate.mjs`'s own header states the same property: "at two calls it
# can run every two minutes all day inside the rate limit, which is the property the whole design rests
# on."
#
# The interval is NOT a latency target. Work is picked up within two minutes of appearing, which is far
# faster than the 10-30 minute crons this replaces, and it costs nothing when the queue is quiet --
# which is most of the time.
OnBootSec=2min
OnUnitActiveSec=2min

# `Persistent=true` WAS HERE AND DID NOTHING -- removed by #2000, and the removal changes no behaviour.
#
# The comment it carried said "without this a missed window is simply skipped rather than caught up".
# `Persistent=` is documented as having effect only on a timer configured with `OnCalendar=`
# (systemd.timer(5)); this timer is monotonic-only, so systemd was never going to perform that catch-up
# and the line asserted a property the unit did not have. Found by #2011's review on the prune timer,
# which had copied the identical pairing; the check that now enforces it reads every shipped timer rather
# than just that one, which is how this instance was found at all.
#
# AND NOTHING IS LOST BY ITS ABSENCE, which is why this is a deletion rather than a conversion to
# `OnCalendar=`. A catch-up is worth having when a missed window means a missed DAY (the corpus snapshot
# at 03:00, the board edition at 07:10, both genuine `OnCalendar` timers). Here the window is two minutes:
# `OnBootSec=2min` already brings the tick back within two minutes of boot, and a tick missed while the
# box was asleep is a tick whose question -- is there work? -- the very next tick asks again.
AccuracySec=10s

[Install]
WantedBy=timers.target
