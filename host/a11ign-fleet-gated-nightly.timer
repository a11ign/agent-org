[Unit]
Description=a11ign: run the nightly fleet-gated batch firing
Requires=a11ign-fleet-gated-nightly.service

[Timer]
# AFTER THE NIGHT'S ORDINARY CAPTURE ACTIVITY, NOT AT MIDNIGHT SHARP -- #914's own recorded pattern
# (batches starting once the day's last capture job has cleared, e.g. 2026-09-20T00:33:30Z) starts its
# by-row work after the day's captures wind down, not on the hour. 01:00 UTC gives that margin while
# staying well inside #914's own "results posted by row, before morning" bar.
OnCalendar=*-*-* 01:00:00 UTC
# A box that was off or asleep at 01:00 fires the missed run at the next boot instead of skipping the
# night entirely -- the same property a11ign-work-tick.timer and a11ign-corpus-snapshot.timer both rely
# on.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
