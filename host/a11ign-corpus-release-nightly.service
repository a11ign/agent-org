[Unit]
# #1042 ITEM 3: the lab's own `a11y-corpus-snapshot.timer` fires daily and produces an archive nobody
# publishes -- a snapshot on the lab is not a backup, which is this row's whole subject. See
# packages/lab/scripts/corpus-release-nightly.mjs for what this does and does not decide -- it fetches the
# newest snapshot and hands it to `corpus:release`, which is already idempotent and self-verifying; this
# unit adds no judgment of its own, the same reason it needs no wake the way #1830's nightly batch does.
Description=a11ign: fetch the lab's newest corpus snapshot and release it
After=herdr.service
Wants=herdr.service

[Service]
Type=oneshot
WorkingDirectory=/home/agent/repos/a11y-witness

# SAME REASON a11ign-fleet-gated-nightly.service AND a11ign-work-tick.service BOTH STATE THEIR OWN: a
# systemd unit gets no login shell's PATH, and this job spawns `ansible-playbook`, `npm` and (through
# `corpus:release`) `gh` and `tar` -- none of them on a unit's default PATH.
Environment=PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# `gh` needs a home to find credentials under, and Ansible its own inventory/vault state from the agent's
# home -- stated rather than assumed, for the identical reason the other two host units state it: the
# failure otherwise is silent, forever.
Environment=HOME=/home/agent

# V8'S COMPILE CACHE GOES UNDER THE HOME, NOT /tmp -- #2458. `tsc`, `eslint`, `rstest` and `changeset` (all reached
# through `npm run`) call `enableCompileCache()` with no directory, which writes `<tmpdir>/node-compile-cache`:
# one entry per file per checkout path, 141,353 inodes in the 2026-09-25 outage. A unit reads no shell startup
# file, so this line is the ONLY place a unit can get it; `host-units.test.ts` pins it on every shipped service.
Environment=NODE_COMPILE_CACHE=%h/.cache/node-compile-cache

# WHICH ACCOUNT THIS NIGHTLY SPENDS, DECLARED -- #1974, AND NOT THE HUMAN ONE (chairman, #1950, #2332).
# `corpus:release` writes releases to `a11ign/corpus-backups`, which `a11ign-ai-workers` can only READ
# (measured 2026-09-22: `pull` and not `push`), so until 2026-09-24 this unit declared the person's own
# config -- and every release since 2026-09-06 was created by `DanBeckDev`, an ADMIN login, by a job nobody
# was watching. The chairman then created `a11ign-ai-leads` (write, not admin; its own GraphQL pool) and
# read back `permissions` on this repository AND on `a11ign/corpus-backups`: `push: true, admin: false` on
# both. That is enough for `gh release create` and no more, so the backup no longer depends on a login that
# could also delete the repository.
#
# The line is still a DECLARATION rather than the wrapper's fallback: a systemd unit has no
# `HERDR_WORKSPACE_ID`, so left undeclared it would inherit the person's account from a dotfile outside this
# tree. `host:check` refuses a unit that declares that account (`HUMAN_ACCOUNT_ALLOWED` is empty), and one
# that reaches `gh` and declares none.
Environment=GH_CONFIG_DIR=/home/agent/leads/gh

# #1911: `lab:fetch` needs A11Y_PVE_KEY (and A11Y_CONTROL_HOST_FILE), which a shell gets from its .zshenv and a
# unit never does -- the unit failed every firing without them. The `-` is deliberate: a missing file is
# left to corpus-release-nightly.mjs's own refusal, which names this file and says why, rather than to
# systemd's generic "Failed to load environment files".
EnvironmentFile=-%h/.config/a11ign/fleet.env

# UPDATED FIRST, same as a11ign-fleet-gated-nightly.service's own ExecStartPre -- a firing against a stale
# checkout could release a snapshot fetched by yesterday's `lab-fetch.yml`. The `-` prefix makes a failed
# update non-fatal: a firing against a slightly stale checkout is worth far more than no firing at all.
ExecStartPre=-/usr/bin/npm run primary:update

ExecStart=/usr/bin/node packages/lab/scripts/corpus-release-nightly.mjs

# Generous relative to a11ign-fleet-gated-nightly.service's 120s: this job moves an archive of real bytes
# over the network twice (fetch, then corpus:release's own upload-and-download verify), not just two `gh`
# calls. Bounded well under the timer's own daily interval so a hang here cannot survive to collide with
# tomorrow's firing.
TimeoutStartSec=1800

[Install]
WantedBy=default.target
