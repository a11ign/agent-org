#!/bin/sh
# gh identity wrapper.
#
# 2026-09-13: engineer sessions use the a11ign-ai-workers account so the human account's GraphQL pool is
# not shared six ways. 2026-09-24 (chairman's ruling, #1950): NO AGENT ACTS AS THE HUMAN. The first version
# was an allow-list for the workers account, so any workspace it did not list FELL THROUGH to the human's
# own login, which has admin. Then the decision-holders were a named TEMPORARY exception on the human
# account because the workers pool could not take them (#2333). The chairman has since created
# a11ign-ai-leads (write, not admin; own GraphQL pool) and logged it in at /home/agent/leads/gh, so:
#
#   1. an explicit GH_CONFIG_DIR always wins (a systemd unit, the codex reviewer, a spawn (#2323));
#   2. an agent workspace on the LEADS list (/home/agent/leads/workspaces.txt: w6 w2 w5 -- ceo,
#      product-manager, orchestrator) gets /home/agent/leads/gh (a11ign-ai-leads);
#   3. any other agent workspace (HERDR_WORKSPACE_ID set) gets /home/agent/workers/gh (a11ign-ai-workers);
#   4. an agent workspace whose config is missing REFUSES, never falls through to the human;
#   5. a shell with no workspace id (a person at a terminal, or a unit that forgot to declare) is not an
#      agent, so it is left alone: the human's own login, as before.
#
# Routing is by herdr workspace id, which survives a session restart.
#
# Shipped from packages/agent-org/host/gh and COPIED to ~/.local/bin/gh by `npm run host:install` (#2332); `npm
# run host:check` reports DIVERGED when the installed bytes differ. A copy and not a symlink, because this is on
# every agent's PATH and a link into a checkout that is mid-rebase would break `gh` for the whole org. The three
# paths below are overridable so a test can RUN this file against a stub; that is no new hole, since an explicit
# GH_CONFIG_DIR already wins over everything here. `git push` goes through it too (the global gitconfig's credential helper).
GH_REAL=${A11Y_GH_REAL:-/home/agent/.local/bin/gh-real}
WORKERS_DIR=${A11Y_WORKERS_DIR:-/home/agent/workers}
LEADS_DIR=${A11Y_LEADS_DIR:-/home/agent/leads}
if [ -z "$GH_CONFIG_DIR" ] && [ -n "$HERDR_WORKSPACE_ID" ]; then
  if grep -qxF "$HERDR_WORKSPACE_ID" "$LEADS_DIR/workspaces.txt" 2>/dev/null; then
    dir=$LEADS_DIR/gh
  else
    dir=$WORKERS_DIR/gh
  fi
  if [ ! -f "$dir/hosts.yml" ]; then
    echo "gh: workspace $HERDR_WORKSPACE_ID is an agent and must not act as the human account, and its account is not installed ($dir/hosts.yml). Refusing." >&2
    exit 1
  fi
  GH_CONFIG_DIR=$dir
  export GH_CONFIG_DIR
fi
exec "$GH_REAL" "$@"
