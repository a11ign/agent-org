#!/bin/sh
# gh identity wrapper.
#
# 2026-09-13: engineer sessions use the a11ign-ai-workers account so the human account's GraphQL pool is
# not shared six ways. 2026-09-24 (chairman's ruling, #1950): NO AGENT ACTS AS THE HUMAN. The first version
# was an allow-list for the workers account, so any workspace it did not list FELL THROUGH to the human's
# own login, which has admin. Then the decision-holders were a named TEMPORARY exception on the human
# account because the workers pool could not take them (#2333). The chairman has since created
# a11ign-ai-leads (write, not admin; own GraphQL pool) and logged it in at @@leadsDir@@/gh, so:
#
#   1. an explicit GH_CONFIG_DIR always wins (a systemd unit, the codex reviewer, a spawn (#2323));
#   2. an agent workspace on the LEADS list (@@leadsDir@@/workspaces.txt: w6 w2 w5 -- ceo,
#      product-manager, orchestrator) gets @@leadsDir@@/gh (a11ign-ai-leads);
#   3. any other agent workspace (HERDR_WORKSPACE_ID set) gets @@workersDir@@/gh (a11ign-ai-workers);
#   4. an agent workspace whose config is missing REFUSES, never falls through to the human;
#   5. a call with no workspace id and no GH_CONFIG_DIR (a plain ssh shell, or a unit that forgot to declare one)
#      REFUSES, never falls through to the human's own login (#3642). The first four rules closed the fall-through for an
#      agent workspace; this one closes it for everything else on the host, because rule 5 used to say "a person at a
#      terminal, left alone" and a plain ssh shell and an undeclared unit are indistinguishable from that person: both
#      acted as the org owner, with admin, and one spent his search limit. Admin acts are done from the chairman's own
#      machine, never from this host. The refusal exits before gh-real and BEFORE THE LEDGER below, so it writes no line:
#      a ledger line goes into the account's own config dir and there is no account here to name.
#
# Routing is by herdr workspace id, which survives a session restart.
#
# Shipped from packages/agent-org/host/gh and COPIED to ~/.local/bin/gh by `npm run host:install` (#2332); `npm
# run host:check` reports DIVERGED when the installed bytes differ. A copy and not a symlink, because this is on
# every agent's PATH and a link into a checkout that is mid-rebase would break `gh` for the whole org. The three
# paths below are overridable so a test can RUN this file against a stub; that is no new hole, since an explicit
# GH_CONFIG_DIR already wins over everything here. `git push` goes through it too (the global gitconfig's credential helper).
GH_REAL=${A11Y_GH_REAL:-@@binDir@@/gh-real}
WORKERS_DIR=${A11Y_WORKERS_DIR:-@@workersDir@@}
LEADS_DIR=${A11Y_LEADS_DIR:-@@leadsDir@@}
if [ -z "$GH_CONFIG_DIR" ] && [ -z "$HERDR_WORKSPACE_ID" ]; then
  # One line, no markup: `git push` reaches this through its credential helper and prints only what the helper's stderr says.
  echo "gh: refusing, no workspace id and no GH_CONFIG_DIR, so this call would act as the human account and no agent may. Run: export GH_CONFIG_DIR=$WORKERS_DIR/gh (or $LEADS_DIR/gh for a lead), or run inside an agent workspace. Admin acts are done from the chairman's own machine." >&2
  exit 1
fi
if [ -z "$GH_CONFIG_DIR" ]; then
  if grep -qxF "$HERDR_WORKSPACE_ID" "$LEADS_DIR/workspaces.txt" 2>/dev/null; then
    dir=$LEADS_DIR/gh
  else
    dir=$WORKERS_DIR/gh
  fi
  if [ ! -f "$dir/hosts.yml" ]; then
    echo "gh: workspace $HERDR_WORKSPACE_ID is an agent and must not act as the human account, and its account is not installed ($dir/hosts.yml). Refusing." >&2
    exit 1
  fi
  GH_CONFIG_DIR=$dir
  export GH_CONFIG_DIR
fi

# --- #4397: `gh pr create` IS OPENED BY `pr:open` ONLY ---------------------------------------------------------------
#
# `pr:open` labels the PR with its session, checks the body's `Acceptance:` and `Closes` with the parser CI uses, and refuses a
# diff outside the row's Region; a raw create skips all three (agent-org#436 was opened that way: no label for 39 minutes, no
# `Closes`). `engineer.md` says "never raw `gh pr create`" and that is a sentence; this is the one choke point every agent's `gh`
# passes through. `pr:open` runs its `gh` child with `A11Y_PR_OPEN=1`, so the variable's absence is a create that did not come
# through it. It binds agents only: a call with no workspace id is already refused above, and a runner has no wrapper. Like the
# refusal above it exits before gh-real and BEFORE THE LEDGER, so it writes no line.
if [ "$1 $2" = "pr create" ] && [ -z "${A11Y_PR_OPEN:-}" ]; then
  echo "gh: refusing 'gh pr create': a pull request is opened with 'pnpm run pr:open', which labels it with your session and checks its Acceptance and Closes lines, and a raw create does neither." >&2
  exit 1
fi

# --- #3466: THE CALL LEDGER -- which call spends which pool, so the burner can be NAMED -------------------------
#
# One TAB-separated line per call, appended to `$GH_CONFIG_DIR/gh-calls.tsv` (the account's own config dir, so a
# ledger is never mixed across accounts): time, account, resource, cost, exit status, `argv[1] argv[2]`, workspace,
# the CALLING process's command line and, LAST, the id of the session that made the call. `src/gh-ledger.ts` reads and reports it.
#
#   - THE SESSION ID is `CLAUDE_CODE_SESSION_ID` (a Claude Code session's environment; it is the file name of its transcript,
#     `~/.claude/projects/<dir>/<id>.jsonl`), else `CODEX_THREAD_ID` (a Codex session's; measured 2026-10-05 in `~/.codex/sessions` rollouts: a value a tool
#     shell printed is the id in its rollout's own file name). `-` when neither is set, which is what a unit or script outside any session writes.
#     It is the 9th field and the LAST, after the caller, so a line from before this one (8 fields) is read unchanged and a reader that
#     only knows 8 fields reads the id as the tail of the caller; the caller never holds a tab (they are replaced below), so a field count of 9 is
#     unambiguous. Only [A-Za-z0-9-] survive, so the id cannot break the line.
#
#   - THE CALL IS NOT CHANGED. Same arguments, same stdin, same stdout and stderr bytes, same exit status. The one
#     thing that is different is that this shell now outlives gh-real (it was an `exec`), so a signal sent to it is
#     FORWARDED, or a timeout that kills this pid would leave gh-real running.
#   - THE LEDGER NEVER FAILS A CALL: every step after gh-real has run is allowed to fail and nothing it does
#     reaches the status. `A11Y_GH_LEDGER=off` skips it; any other value is the file's path (a test's).
#   - `cost` is the `rateLimit.cost` the RESPONSE carries, so it exists only for `gh api graphql` whose query asked for
#     `rateLimit { cost }` and whose output is not filtered by `--jq`/`--template`; otherwise it is empty, and an empty
#     cost on a graphql line means "at least one point", never zero. stdout is captured only when it is not a terminal
#     (gh formats for a terminal) and is written back unchanged.
#   - `resource`: `graphql` and `core` are read off `api graphql` / `api <path>`; a `?` marks a pool INFERRED from the
#     command family (`pr`, `issue`, `project`... spend GRAPHQL), because gh does not say.
#   - BOUNDED: past A11Y_GH_LEDGER_MAX_BYTES (2 MiB) the newest half is kept. Two calls trimming at once can drop a few
#     lines; a bounded diagnostic does not take a lock on every gh call for that.
#   - A11Y_GH_LEDGER_NOW stands in for the clock, as A11Y_GH_REAL does for the exec: a test pins both.

# The calling session's id, as the ledger and the attribution below both read it: `CLAUDE_CODE_SESSION_ID`, else `CODEX_THREAD_ID`, else empty.
session_id() {
  printf %s "${CLAUDE_CODE_SESSION_ID:-${CODEX_THREAD_ID:-}}" | tr -dc 'A-Za-z0-9-' | cut -c1-64
}

ledger_record() { # status stdout-copy first-arg second-arg
  [ "${A11Y_GH_LEDGER:-}" = off ] && return 0
  cfg=${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}
  file=${A11Y_GH_LEDGER:-$cfg/gh-calls.tsv}
  case "$3 $4" in
    "api graphql") resource=graphql ;;
    api\ *) resource=core ;;
    pr\ *|issue\ *|project\ *|repo\ *|label\ *|discussion\ *) resource='graphql?' ;;
    *) resource=other ;;
  esac
  resource=${LEDGER_RESOURCE:-$resource}
  cost=
  if [ "$resource" = graphql ] && [ -n "$2" ] && [ -s "$2" ]; then
    cost=$(grep -o '"rateLimit": *{[^}]*}' "$2" | grep -o '"cost": *[0-9]*' | tr -dc '0-9\n' |
      awk '{ s += $1; n++ } END { if (n) print s }')
  fi
  account=$(sed -n 's/^ *user: *//p' "$cfg/hosts.yml" | head -n 1)
  caller=$(tr '\0\t\n' '   ' < "/proc/$PPID/cmdline" | cut -c1-160)
  session=$(session_id)
  now=${A11Y_GH_LEDGER_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}
  printf '%s\t%s\t%s\t%s\t%s\t%s %s\t%s\t%s\t%s\n' "$now" "${account:-unknown}" "$resource" "$cost" "$1" "$3" "$4" \
    "${HERDR_WORKSPACE_ID:--}" "$caller" "${session:--}" >> "$file" || return 0
  max=${A11Y_GH_LEDGER_MAX_BYTES:-2097152}
  if [ "$(wc -c < "$file")" -gt "$max" ]; then
    tail -c "$((max / 2))" "$file" | tail -n +2 > "$file.trim" || return 0
    rollup_dropped "$file" "$(($(wc -c < "$file") - $(wc -c < "$file.trim")))" && mv "$file.trim" "$file"
  fi
}

# --- #4148: THE HOURLY ROLLUP -- a reading for any hour, though the ledger keeps only the newest half -------------
#
# What the trim is about to drop is counted FIRST, per UTC hour, account and resource, into `<ledger>.hourly` (one TAB line:
# hour, account, resource, calls, points READ, floor points; the same two numbers `gh-ledger.ts` reads off a ledger line, so a
# reading adds the two files and never double-counts: a line is in the ledger or in the rollup, never both). Merged on every trim
# so the file holds one line per hour x account x resource and not one per trim. If the rollup cannot be written the trim does NOT
# go ahead (the caller's `&&`): a kept ledger past its bound is a diagnostic's lesser harm than a lost hour. Two calls trimming at
# once can count a span twice, which is the race the trim above already accepts.
rollup_dropped() { # ledger-file dropped-bytes
  { cat "$1.hourly" 2>/dev/null; head -c "$2" "$1"; } | awk -F'\t' '
    NF == 6 { k = $1 "\t" $2 "\t" $3; calls[k] += $4; read[k] += $5; floor[k] += $6 }
    NF >= 8 && $1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]/ {
      res = $3; sub(/\?$/, "", res); k = substr($1, 1, 13) "\t" $2 "\t" res
      calls[k] += 1; if ($4 != "") read[k] += $4
      floor[k] += ($4 != "" ? $4 : (res == "graphql" ? 1 : 0)) }
    END { for (k in calls) printf "%s\t%d\t%d\t%d\n", k, calls[k], read[k], floor[k] }' | sort > "$1.hourly.$$" &&
    mv "$1.hourly.$$" "$1.hourly"
}


# --- #4148: THE READ CACHE -- the same READ, asked again, is answered from disk and spends no point ------------
#
# THE COST WAS NEVER ONE EXPENSIVE CALL: it was the same `pr list`, `issue list` and `pr view` asked again and again (4,400 calls
# in 72 minutes, 2026-10-08), by the tick, its children and sessions polling `gh pr checks`. Two lifetimes, one store (`$GH_CONFIG_DIR/read-cache`):
#
#   1. N SECONDS (`A11Y_GH_READ_CACHE_SECONDS`, default 20, clamped to 30): an IDENTICAL read (same arguments, same repository, same
#      directory and branch, since a bare `gh pr view` answers for the branch) is answered from the entry a moment ago. Any caller.
#   2. THE TICK'S SNAPSHOT: a process the tick started carries `A11Y_TICK_SNAPSHOT`, and its entry stays good while the repository's
#      GENERATION has not moved. `tick-snapshot.ts` moves it from a REST call that costs nothing when nothing changed (a 304), once per
#      tick; the generation is `<counter> <last verified>` and an entry is not served past `A11Y_TICK_SNAPSHOT_MAX_AGE` (150 s) of
#      the last verification, so a tick that stopped refreshing stops being believed. A session (no such variable) is never served this.
#
# WHAT IS CACHED is a READ that exited 0: `pr|issue|label|repo|run|release` list/view/status/checks/diff, and a plain `gh api <path>` GET.
# NEVER cached: a `--web`/`--watch` call, `gh api` with `-i`/`--include` or `-H` (the `X-Ratelimit-*` headers, and every ETag probe,
# are an answer about NOW: #1967, #1275) or `rate_limit`, and `gh api graphql` (a POST). WHAT DROPS THE CACHE: any call that is not a read and not
# known to be neutral, by this account (`pr merge`, `issue edit`, an unknown verb), and only the REPOSITORY it names (`-R`, $GH_REPO, or the
# `repos/<owner>/<repo>` of an `api` path) plus the reads that named none; a write naming no repository drops the whole store. NOT a write:
# `auth git-credential` (the helper behind every `git fetch` and `git push`, which writes nothing to GitHub) and an `api` call whose named
# method is GET (`-f` is then a query parameter): a11ign#4616 measured these emptying the store about every 5 seconds. A write by another
# account, or a person, is not seen here: that is what the 20 s and the tick's generation bound.
# `A11Y_GH_READ_CACHE=off` skips all of it. A hit is recorded in the ledger as resource `cache`: it spends no point, and the ledger can show the hit rate.

# Sets `class` to read | write | neutral for the arguments given.
call_class() {
  class=read
  case "$1" in
    pr|issue|label|repo|run|release) case "$2" in list|view|checks|status|diff) ;; *) class=write; return 0 ;; esac ;;
    api) ;;
    auth) case "$2" in status|token|git-credential) class=neutral ;; *) class=write ;; esac; return 0 ;;
    ""|--version|version|help) class=neutral; return 0 ;;
    *) class=write; return 0 ;;
  esac
  if [ "$1" = api ]; then
    if [ "$2" = graphql ]; then
      class=neutral
      for a; do case "$a" in *mutation*) class=write ;; esac; done
      return 0
    fi
    api_method=; api_body=0; api_input=0; api_neutral=0; prev=
    for a; do
      case "$prev" in -X|--method) api_method=$a ;; esac
      case "$a" in
        -X?*) api_method=${a#-X} ;;
        --method=*) api_method=${a#--method=} ;;
        --input|--input=*) api_body=1; api_input=1 ;;
        -f|-F|-f*|-F*|--field|--field=*|--raw-field|--raw-field=*) api_body=1 ;;
        -i|--include|-H|--header|--header=*|--cache|--cache=*|rate_limit|*/rate_limit) api_neutral=1 ;;
      esac
      prev=$a
    done
    # The METHOD decides, not the flags: `-f`/`-F` make gh send a POST only when no method is named, and with `--method GET` they
    # are query parameters of a read. A named GET is a read; any other named method is a write; none named is a write if a body flag
    # is present. `--input` sends a body, so it stays a write whatever the method says.
    api_method=$(printf %s "$api_method" | tr 'a-z' 'A-Z')
    if [ "$api_input" = 1 ]; then
      class=write
    elif [ -n "$api_method" ]; then
      [ "$api_method" = GET ] || class=write
    elif [ "$api_body" = 1 ]; then
      class=write
    fi
    [ "$class" = read ] && [ "$api_neutral" = 1 ] && class=neutral
    return 0
  fi
  for a; do case "$a" in -w|--web|--watch|-h|--help|-i|--include) class=neutral ;; esac; done
}

# Sets `repo_slug`: the repository the call names (`-R`/`--repo`, else $GH_REPO), as a file name; `default` when it names none.
read_repo_slug() {
  r=${GH_REPO:-}
  prev=
  for a; do
    case "$prev" in -R|--repo) r=$a ;; esac
    case "$a" in --repo=*) r=${a#--repo=} ;; esac
    prev=$a
  done
  repo_slug=$(printf %s "${r:-default}" | tr -c 'A-Za-z0-9._-' '_')
}

# Sets `repo_slug` for a WRITE: as `read_repo_slug`, except that `gh api repos/<owner>/<repo>/...` names its repository in the path, which
# outranks $GH_REPO. A path with a `{owner}` placeholder is resolved by gh from elsewhere, so it names nothing here.
write_repo_slug() {
  read_repo_slug "$@"
  for a; do
    case "$a" in
      *\{*) ;;
      repos/*/*|/repos/*/*) p=${a#/}; p=${p#repos/}; rest=${p#*/}
        repo_slug=$(printf %s "${p%%/*}/${rest%%/*}" | tr -c 'A-Za-z0-9._-' '_'); return 0 ;;
    esac
  done
}

# Entries are named `<repository>~<key>` (the repository lower-cased, GitHub's names being case-insensitive; `~` is not in the slug's
# alphabet, so the prefix is exact), so that a write can drop ONE repository's reads.
entry_prefix() { printf %s "$1" | tr 'A-Z' 'a-z'; }

# A write to repository X drops X's entries and those of `default` (a read that named no repository is the one whose repository this
# wrapper cannot know: gh takes it from the directory's remote), and leaves every other repository's. A write that names no repository
# drops the whole store: the fail-safe, since it may have changed any of them.
drop_read_cache() {
  write_repo_slug "$@"
  if [ "$repo_slug" = default ]; then
    rm -f "${RC:?}"/e/* 2>/dev/null
  else
    prefix=$(entry_prefix "$repo_slug")
    rm -f "${RC:?}/e/${prefix:?}~"* "${RC:?}/e/default~"* 2>/dev/null
  fi
}

# Succeeds when `$entry` may answer this call. `entry_gen` is the generation the entry was stored under.
read_cache_fresh() {
  [ -f "$entry" ] || return 1
  IFS=' ' read -r stamp entry_gen 2>/dev/null < "$entry" || return 1
  now_s=$(date +%s)
  [ "$((now_s - stamp))" -le "$ttl" ] && return 0
  [ -n "${A11Y_TICK_SNAPSHOT:-}" ] && [ -n "$entry_gen" ] || return 1
  IFS=' ' read -r cur verified 2>/dev/null < "$RC/gen/$repo_slug" || return 1
  [ "$cur" = "$entry_gen" ] && [ "$((now_s - verified))" -le "${A11Y_TICK_SNAPSHOT_MAX_AGE:-150}" ]
}

read_cache_store() { # the stdout copy, the generation read BEFORE the call ran
  mkdir -p "$RC/e" 2>/dev/null || return 0
  { printf '%s %s\n' "$(date +%s)" "$1"; cat "$2"; } > "$entry.$$" 2>/dev/null && mv "$entry.$$" "$entry" 2>/dev/null
  [ "$(($$ % 16))" -eq 0 ] && find "$RC/e" -type f -mmin +60 -exec rm -f {} + 2>/dev/null
  return 0
}

# --- #4505 MOVE 0 (agent-org#486): A DECISION COMMENT CARRIES THE ROLE AND RUN THAT POSTED IT --------------------------------
#
# `ceo`, `product-manager` and `orchestrator` post as ONE account (a11ign-ai-leads), so a comment on a row cannot say which of them decided,
# and the epic's measure (chairman corrections per day) and its cutovers need that. Managers post by running `gh issue comment` themselves, so
# this wrapper is the one place every post passes. For `issue comment`, `pr comment` and `pr review` it appends ONE trailing line to the body,
#
#     <!-- decided-by: <role> run: <id> -->
#
# an HTML comment, so the rendered comment reads as before and the API's raw body carries it.
#
#   - THE ROLE is the herdr label of $HERDR_WORKSPACE_ID (`ceo`, `product-manager`, `orchestrator`, `worker-agent-org-486`): the seat's name,
#     read from herdr's own socket, which costs no GitHub point. THE RUN is the session id the ledger above records (a Claude Code session's
#     id, else a Codex thread's), which changes when a seat restarts, so it names which instance of the seat posted. No run id leaves the
#     role alone: `<!-- decided-by: <role> -->`.
#   - NEVER A GUESS: no workspace id, a herdr that does not answer, an answer for another workspace, or a label with a character outside
#     [A-Za-z0-9._-] means NO LINE. The line is a statement about who decided, and an absent line is true where a wrong one is not.
#   - A BODY THAT CANNOT BE REWRITTEN IS POSTED UNCHANGED, never refused: a file that cannot be read, no scratch directory, a body that
#     already ends in a `decided-by:` line (so a nested call never stacks two) and a call naming no body (`--edit-last`, `--web`) all go
#     through exactly as given. The spellings handled are `--body X`, `--body=X`, `-b X`, `-bX`, `-b=X`, and `--body-file P`, `--body-file=P`,
#     `-F P`, `-FP`, `-F=P` where P is a path or `-` for stdin: a file body is read once, and gh is given a scratch copy with the line added.
#   - Any other command, `gh api` included, is not touched: the argument list is rebuilt only for the three.
decided_by_line() {
  [ -n "${HERDR_WORKSPACE_ID:-}" ] || return 0
  herdr_out=$(
    if command -v timeout >/dev/null 2>&1; then timeout 5 "${HERDR_BIN_PATH:-herdr}" workspace get "$HERDR_WORKSPACE_ID"
    else "${HERDR_BIN_PATH:-herdr}" workspace get "$HERDR_WORKSPACE_ID"; fi 2>/dev/null) || return 0
  [ "$(printf %s "$herdr_out" | sed -n 's/.*"workspace_id": *"\([^"]*\)".*/\1/p')" = "$HERDR_WORKSPACE_ID" ] || return 0
  role=$(printf %s "$herdr_out" | sed -n 's/.*"label": *"\([^"]*\)".*/\1/p')
  case "$role" in ''|*[!A-Za-z0-9._-]*) return 0 ;; esac
  [ "${#role}" -le 64 ] || return 0
  run=$(session_id)
  if [ -n "$run" ]; then printf '<!-- decided-by: %s run: %s -->' "$role" "$run"
  else printf '<!-- decided-by: %s -->' "$role"; fi
}

# Prints the body with the line appended after a blank line, or the body itself when it already ends in one. `$1` body, `$2` the line.
attributed_text() {
  case "$(printf '%s\n' "$1" | awk 'NF { l = $0 } END { print l }')" in
    "<!-- decided-by: "*) printf '%s' "$1" ;;
    *) printf '%s\n\n%s' "$1" "$2" ;;
  esac
}

# `$1` a body: prints it with the line, or unchanged.
attributed_body() {
  attributed_text "$1" "$decided_by"
}

# `$1` a path or `-`, `$2` a name unique in this call: prints the path of a scratch copy with the line, or `$1` when it cannot be made.
attributed_file() {
  [ -n "$attr_dir" ] || { printf '%s' "$1"; return 0; }
  if [ "$1" = - ]; then text=$(cat) || { printf '%s' "$1"; return 0; }
  else text=$(cat -- "$1" 2>/dev/null) || { printf '%s' "$1"; return 0; }; fi
  attributed_text "$text" "$decided_by" > "$attr_dir/$2" 2>/dev/null && printf '\n' >> "$attr_dir/$2" 2>/dev/null &&
    printf '%s' "$attr_dir/$2" || printf '%s' "$1"
}

attr_dir=
case "$1 $2" in
  "issue comment"|"pr comment"|"pr review")
    decided_by=$(decided_by_line)
    if [ -n "$decided_by" ]; then
      attr_dir=$(mktemp -d "${TMPDIR:-/tmp}/gh-body.XXXXXX" 2>/dev/null) || attr_dir=
      attr_n=$#; attr_i=0; attr_want=
      while [ "$attr_i" -lt "$attr_n" ]; do
        a=$1; shift; attr_i=$((attr_i + 1))
        if [ -n "$attr_want" ]; then
          if [ "$attr_want" = body ]; then a=$(attributed_body "$a"); else a=$(attributed_file "$a" "$attr_i"); fi
          attr_want=
        else
          case "$a" in
            --body|-b) attr_want=body ;;
            --body-file|-F) attr_want=file ;;
            --body=*) a=--body=$(attributed_body "${a#--body=}") ;;
            --body-file=*) a=--body-file=$(attributed_file "${a#--body-file=}" "$attr_i") ;;
            -b=*) a=-b=$(attributed_body "${a#-b=}") ;;
            -F=*) a=-F=$(attributed_file "${a#-F=}" "$attr_i") ;;
            -b?*) a=-b$(attributed_body "${a#-b}") ;;
            -F?*) a=-F$(attributed_file "${a#-F}" "$attr_i") ;;
          esac
        fi
        set -- "$@" "$a"
      done
    fi
    ;;
esac

call_class "$@"
cache_on=0
RC=${A11Y_GH_READ_CACHE_DIR:-$GH_CONFIG_DIR/read-cache}
if [ "$class" = read ] && [ "${A11Y_GH_READ_CACHE:-}" != off ] && [ ! -t 1 ]; then
  ttl=${A11Y_GH_READ_CACHE_SECONDS:-20}
  case "$ttl" in ''|*[!0-9]*) ttl=20 ;; esac
  [ "$ttl" -gt 30 ] && ttl=30
  read_repo_slug "$@"
  key=$({ for a; do printf '%s\0' "$a"; done; printf '%s\0%s\0%s' "${GH_REPO:-}" "$PWD" "$(git symbolic-ref -q HEAD 2>/dev/null)"; } | sha1sum | cut -c1-40)
  entry=$RC/e/$(entry_prefix "$repo_slug")~$key
  gen0=
  [ -n "${A11Y_TICK_SNAPSHOT:-}" ] && { IFS=' ' read -r gen0 _ 2>/dev/null < "$RC/gen/$repo_slug" || gen0=; }
  if read_cache_fresh; then
    LEDGER_RESOURCE=cache
    ledger_record 0 "" "$1" "$2" 2>/dev/null || :
    exec tail -n +2 "$entry"
  fi
  cache_on=1
fi

# stdout is captured for the one call that can carry a cost and for a read that may be stored, and only when it is not a terminal.
copy=
if { [ "$1 $2" = "api graphql" ] || [ "$cache_on" = 1 ]; } && [ ! -t 1 ]; then
  copy=$(mktemp "${TMPDIR:-/tmp}/gh-call.XXXXXX" 2>/dev/null) || copy=
fi
# gh-real runs in the background so this shell can forward a signal, and dash gives a background command /dev/null for stdin
# even for `<&0` (measured: the piped body vanished), so stdin is carried on fd 3. A closed stdin is tested first because a
# failing `exec` redirection ends the shell.
if (exec 3<&0) 2>/dev/null; then exec 3<&0; else exec 3</dev/null; fi
if [ -n "$copy" ]; then "$GH_REAL" "$@" <&3 3<&- > "$copy" & else "$GH_REAL" "$@" <&3 3<&- & fi
child=$!
exec 3<&-
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
wait "$child"
status=$?
# a trapped signal ends the first `wait` early with 128+n while the child is still dying; wait for its real status
kill -0 "$child" 2>/dev/null && { wait "$child"; status=$?; }
trap - TERM INT HUP
[ -n "$copy" ] && cat "$copy"
ledger_record "$status" "$copy" "$1" "$2" 2>/dev/null || :
[ "$cache_on" = 1 ] && [ -n "$copy" ] && [ "$status" -eq 0 ] && read_cache_store "$gen0" "$copy"
[ "$class" = write ] && [ "${A11Y_GH_READ_CACHE:-}" != off ] && drop_read_cache "$@"
[ -n "$copy" ] && rm -f "${copy:?}"
[ -n "$attr_dir" ] && rm -rf "${attr_dir:?}"
exit "$status"
