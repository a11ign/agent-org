[Unit]
# THE DAILY BOARD EDITION'S REAL DISPATCH -- #1234, shipped here by #1993.
#
# GitHub's own `schedule` trigger on `board-report.yml` has never once fired inside its stated window on
# this repository: measured 5-9 hours late, every time, landing in the 12:00-13:56Z band instead of
# 07/08Z. The schedule stays on as a backstop; THIS is what actually produces the edition `ceo` reads
# each morning. See #1234 for the derivation.
#
# WHY IT IS IN THE TREE AT ALL, which is the whole of #1993. This pair was hand-installed on 2026-09-18
# and never committed, so `host:check` saw "installed and not shipped by this repository" -- its only
# reading of that bit was *retired* -- and printed the one remedy it has: `npm run host:install`, which
# DELETES an orphan. The units it offered to delete were the live board dispatch, firing at 07:10 every
# morning. Nothing would have reported the loss except an edition that never arrived.
#
# So the fix is not a smarter warning, it is this file. A unit that runs daily and appears nowhere in the
# tree cannot be checked, cannot be reviewed, and cannot be reasoned about by anything here.
Description=Dispatch the a11y-witness board-report workflow (#1234)

[Service]
Type=oneshot

# PATH IS DECLARED BECAUSE A SYSTEMD UNIT DOES NOT GET A LOGIN SHELL'S -- the same reason
# a11ign-work-tick.service and a11ign-corpus-release-nightly.service both state their own.
#
# MEASURED 2026-09-22 on this host: the user manager's PATH is
# `/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:...` -- it does NOT contain
# /home/agent/.local/bin. The dispatch script calls a bare `gh`, so under the installed pair that
# resolved to /usr/bin/gh, THE REAL BINARY: the routing wrapper at /home/agent/.local/bin/gh was not
# merely unconfigured here, it was never executed. This line puts the wrapper back on the path the rest
# of this host uses, so the unit and an interactive session are running the same `gh`.
Environment=PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# `gh` needs a home to find credentials under. Stated rather than assumed, for the identical reason the
# other host units state it: the failure otherwise is silent, forever.
Environment=HOME=/home/agent

# WHICH ACCOUNT THIS DISPATCH SPENDS, DECLARED -- and this line CHANGES it, which the other two #1974
# lines did not. Stated rather than inherited was only half the defect here; the inherited value was
# also the wrong one.
#
# WHAT IT WAS. With no PATH and no GH_CONFIG_DIR, the script's bare `gh` was /usr/bin/gh reading
# ~/.config/gh -- `DanBeckDev`, a PERSON. Each firing is one `gh workflow run` plus up to ten
# `gh run list` polls against that human's REST pool, daily, by a route no check in this repository
# could see: the wrapper routes on `HERDR_WORKSPACE_ID`, which every org session has and no systemd unit
# does.
#
# WHY THE WORKERS ACCOUNT IS RIGHT HERE, where a11ign-corpus-release-nightly.service's human account was.
# That unit publishes to `a11ign/corpus-backups`, where `a11ign-ai-workers` has `pull` and NOT `push`, so
# pointing it at the workers config would 403 and take the offsite backup down. Nothing of the sort
# applies to this one. Measured 2026-09-22 on `a11ign/a11ign`: `a11ign-ai-workers` has `push: true`, and
# it has ALREADY dispatched four `workflow_dispatch` runs on this repository (consumer-gate 2026-09-18,
# release x3 2026-09-13) -- so the dispatch call is accepted for that account as a fact rather than as an
# inference from a permission bit.
#
# AND THE EDITION ITSELF DOES NOT DEPEND ON WHO DISPATCHED IT. `board-report.yml` runs on
# `${{ github.token }}` under its own `permissions:` block (contents: read, issues: write,
# discussions: write); the dispatcher only has to be allowed to POST the dispatch. The visible change is
# the run's actor, from a person to the account the org's other machinery already uses.
Environment=GH_CONFIG_DIR=/home/agent/workers/gh

# THE SCRIPT IS NOT SHIPPED HERE AND THAT IS A REMAINING GAP, deliberately left rather than missed:
# #1993 scoped itself to the units and #1998 owns the script, on the same footing as the `gh` wrapper
# (#1974's own exclusion). `unitsSpendingGh` treats an out-of-tree ExecStart as UNANALYSABLE rather than
# as clean, which is why this unit is charged for an identity it cannot be read to need.
ExecStart=/home/agent/.local/bin/board-report-dispatch.sh

# NO [Install] SECTION, and its absence is load-bearing. `WantedBy=default.target` -- which the other
# shipped services carry -- would start this oneshot at every boot, and every boot would dispatch
# another board edition. The timer is the only thing that may start it.
