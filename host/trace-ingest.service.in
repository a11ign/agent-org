[Unit]
# THE TRACE STORE'S OWN CLOCK -- a11ign/agent-org#498 (chairman direction on a11ign/a11ign#4437, class `metrics-outage`: "if no `turn` event lands for 10 minutes while any session is
# working, raise an incident to the owning seat").
#
# `src/trace/freshness.ts` runs `trace -- --ingest` (the transcripts, the wake ledger, the `gh` call ledgers and the deferral log into the store, nothing rendered and no GitHub call)
# and then asks whether the store is stale: no `turn` for ten minutes while a transcript has changed in the last ten. A stale store raises ONE incident for the episode (a comment on
# the standing row and an order to the owning seat) and not again until it has recovered. The ingest's exit code is the unit's, so a unit that cannot ingest shows FAILED.
#
# HOW THIS AND THE PAGES PUBLISHER ARE KEPT APART. `trace-publish.service` decides on the heads of `main` and regenerates pages, and its trace run reads GitHub; this unit reads
# only the host's own files and renders nothing. They share the store and nothing else: each appends whole lines to it (a line that lands twice reads as one, the last copy of an
# id winning) and each writes its ingest state by rename, so the worst overlap is a transcript read twice, never a half-written file. The two do not take a lock: the publisher
# never did, and this unit cannot overlap itself (Type=oneshot, and a timer does not start a unit that is still running).
Description=Ingest the trace store every five minutes and raise an incident when it is stale (agent-org#498)

[Service]
Type=oneshot

# The checkout the repository-relative ExecStart resolves against, as the other units that run a script from this repository do.
WorkingDirectory=@@checkout@@

# PATH IS DECLARED because a systemd unit does not get a login shell's. The incident is posted with a bare `gh`, and it is in @@binDir@@: the routing wrapper.
Environment=PATH=@@binDir@@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The transcripts, the store and the wake ledger are read under the home. Stated rather than assumed.
Environment=HOME=@@home@@

# V8's compile cache goes under the home, not /tmp (#2458); a unit reads no shell startup file, and `host-units.test.ts` pins this on every shipped service.
Environment=NODE_COMPILE_CACHE=%h/.cache/node-compile-cache

# WHICH ACCOUNT IT SPENDS, DECLARED: the org's own (`a11ign-ai-workers`), never the person's. The ingest makes no GitHub call; the one call this unit can make is the comment on the
# standing row, once per stale episode.
Environment=GH_CONFIG_DIR=@@workersDir@@/gh

# A COLD START (a lost state file) re-reads every transcript in the window, which is minutes; a run that hangs must fail and not hold the next slot. The ingest has its own twenty-
# minute limit inside this one.
TimeoutStartSec=2400

# `%h/.local/bin/node <repository-relative path>`, the shape shadow-window.service explains: the tree copy IS the program, not copied anywhere.
ExecStart=%h/.local/bin/node packages/agent-org/src/trace/freshness.ts

# NO [Install] SECTION, and its absence is load-bearing: `WantedBy=default.target` would run this oneshot at every boot. The timer is the only thing that may start it.
