[Unit]
# THE CHAIRMAN-MESSAGING WATCHER -- a11ign/a11ign#2901, row 2 of 13 (design: #2899, docs/messaging.md decision 1). It is the SEPARATE watcher
# unit the design asks for, in the `fleet-watch` / `lab-watch` pattern: events come from a clock that reads GitHub and the ledger, never from
# inside `work-tick`, so nothing here edits `work-gate.ts` or `wake.ts`.
#
# **OPTIONAL, AND OFF BY DEFAULT.** This template is installed ONLY when `.agent-org/project.json` carries a `messaging` key
# (`OPTIONAL_UNITS` in host-units.ts). With the key absent `host:check` does not list it, `host:install` does not write it, and an installed
# copy is reported as an orphan and removed, so deleting the key is also how the chairman turns this off.
#
# THE PROGRAM IT RUNS (`messaging:watch`) IS ROWS 4 AND 5's: this row ships the clock and the switch, not what the clock calls. With the key
# present and that script absent, `host:check` names the missing program, which is the right thing for it to say.
Description=a11ign: look for what the chairman should be told, and tell them (chairman messaging, #2899)
After=herdr.service

[Service]
Type=oneshot
WorkingDirectory=@@checkout@@

# SAME REASON EVERY OTHER SHIPPED SERVICE DECLARES THEM: a systemd unit gets no login shell's PATH and no HOME.
Environment=PATH=@@binDir@@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=@@home@@

# V8'S COMPILE CACHE GOES UNDER THE HOME, NOT /tmp -- #2458; `host-units.test.ts` pins it on every shipped service.
Environment=NODE_COMPILE_CACHE=%h/.cache/node-compile-cache

# THE WORKERS ACCOUNT, AND NEVER THE PERSON'S (#1974, #1950): this watcher reads `needs:chairman` rows and the merge queue, so it spends
# GitHub's API, and a unit with no `HERDR_WORKSPACE_ID` falls back to a person's stored credentials unless it says otherwise.
Environment=GH_CONFIG_DIR=@@workersDir@@/gh

# **NO SECRET APPEARS IN THIS FILE, AND NONE IS PASSED IN THE ENVIRONMENT.** The bot token and the chairman's ids are read by REFERENCE
# from the files `messaging.tokenFile` and `messaging.chairmanFile` name (mode 0600, under ~/.config/agent-org/); a unit file is world
# readable and `systemctl show` prints an `Environment=` line, so a token here would be published to every user of the host.
# There is deliberately no `EnvironmentFile=` either, for the same reason: the program opens the file itself and checks its mode first.
ExecStart=%h/.local/bin/pnpm run messaging:watch

# A WATCHER THAT HANGS MUST NOT HOLD THE NEXT FIRING: it makes one bounded pass over GitHub and one provider call per event.
TimeoutStartSec=240

# NO `[Install]` SECTION: the timer is the only thing that may start this, as for @@prefix@@worktree-prune.service.
