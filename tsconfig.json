{
  // THE PROGRAM `npm run typecheck` CHECKS AND CI REQUIRES (a11ign/a11ign#3551, toolchain row 4a of #3550). It is every `.ts` and every `.mjs` under `src/`; a `.mjs` is
  // checked only when it carries `// @ts-check` (`checkJs` stays false, so the pragma keeps meaning what it meant), and every `*.test.ts` is checked.
  //
  // `exclude` NAMES WHAT IS NOT YET CLEAN, so a NEW file is checked from its first commit and the list can only shrink: fix a file, delete its line. It is not a way to
  // silence a file that others import, because TypeScript follows imports and checks an excluded file reached from an included one anyway. That is why the sources
  // behind these tests were fixed in the pull request that added this file, and only the leaves nothing included imports are listed.
  "compilerOptions": {
    // ES2023, not ES2022: `toSorted`, `findLast` and `findLastIndex` are in the sources, and engines is node >=22, which has all three.
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    // The tests import each other as `./x.ts`, which Node strips types for and `tsc` refuses without this.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"],
  "exclude": [
    // CANNOT BE CHECKED IN THIS TREE: each imports a sibling module that lives in the project the tool is installed in (`packages/lab/src/packaging/`), which the `gate` job copies
    // in beside the tests and a checkout of this repository alone does not have (TS2307). Removing these needs the siblings here, or a typecheck run in the project's layout; copying
    // them in would fork a file two repositories must keep identical (a11ign/a11ign#3571). Every other file the program names is checked.
    "src/packaging/merge-guard-checks-rule.test.ts",
    "src/packaging/merge-guard.test.ts",
    "src/packaging/tracker-leak-refusal.test.ts",
    "src/packaging/workflow-run-liveness.test.ts",
    // NEVER TYPECHECKED BEFORE, CONVERTED BY `js-to-ts` (a11ign/a11ign#4269): these trace tests were `.mjs` with no `// @ts-check`, so strict mode has never read them. The script renamed them and
    // TypeScript's `inferFromUsage` typed what it could; what is left is fixture shapes the inference fitted to the first call (`null` where a later call passes a number, an object literal
    // missing a field the next one has) and the `possibly undefined` reads a test makes on purpose. Measured 2026-10-09 with `tsc --noEmit`: 591 errors in these 11 files. Fix a file, delete its line.
    "src/trace/aggregate.test.ts",
    "src/trace/clock-feed.test.ts",
    "src/trace/github-events.test.ts",
    "src/trace/growth.test.ts",
    "src/trace/otel-receiver.test.ts",
    "src/trace/publish.test.ts",
    "src/trace/swimlane.test.ts",
    "src/trace/trace.test.ts",
    "src/trace/triage-sample.test.ts",
    "src/trace/wake-cache.test.ts",
    "src/trace/waterfall.test.ts",
    // NEVER TYPECHECKED BEFORE, CONVERTED BY `js-to-ts` (a11ign/a11ign#4270): the same shape as the trace tests above, for `src/messaging/`. The 10 sources there are clean; these 31 tests were `.mjs` with no
    // `// @ts-check`, and what is left after `inferFromUsage` is fixture shapes fitted to the first call (`never[]` where a later call pushes a string, a stub missing a field the next one has). Measured
    // 2026-10-09 with `tsc --noEmit`: 451 errors in these 31 files. Fix a file, delete its line.
    "src/messaging/answers.test.ts",
    "src/messaging/ask-ceo.test.ts",
    "src/messaging/classify.test.ts",
    "src/messaging/converse.test.ts",
    "src/messaging/core.test.ts",
    "src/messaging/correct.test.ts",
    "src/messaging/forme-button.test.ts",
    "src/messaging/github-writer.test.ts",
    "src/messaging/inbound.test.ts",
    "src/messaging/listen.test.ts",
    "src/messaging/measure.test.ts",
    "src/messaging/placeholders.test.ts",
    "src/messaging/providers/telegram/pair.test.ts",
    "src/messaging/providers/telegram/poll.test.ts",
    "src/messaging/providers/telegram/send.test.ts",
    "src/messaging/record.test.ts",
    "src/messaging/reply-cli.test.ts",
    "src/messaging/reply.test.ts",
    "src/messaging/secret.test.ts",
    "src/messaging/selftest.test.ts",
    "src/messaging/session-queue.test.ts",
    "src/messaging/sources/incidents.test.ts",
    "src/messaging/sources/milestones.test.ts",
    "src/messaging/sources/readers.test.ts",
    "src/messaging/sources/requests.test.ts",
    "src/messaging/sources/stall.test.ts",
    "src/messaging/sources/summary.test.ts",
    "src/messaging/walk.test.ts",
    "src/messaging/watch-buttons.test.ts",
    "src/messaging/watch-list.test.ts",
    "src/messaging/watch-provider.test.ts"
  ]
}
